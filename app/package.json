{
  "name": "grok2api-creative-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.6.2",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/mock-grok2api.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "android:open": "cap open android",
    "android:build": "pnpm build && cap sync android && cd android && gradlew.bat assembleDebug",
    "android:release": "pnpm build && cap sync android && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "7.6.8",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.3",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "dompurify": "^3.2.6",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.7.1",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@eslint/js": "^9.32.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
